{
  "expo": {
    "name": "MustacheFinanceMobile",
    "slug": "MustacheFinanceMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon.png",
    "scheme": "mustachefinancemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171923",
        "foregroundImage": "./assets/logo/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171923",
          "image": "./assets/logo/splashscreen.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
